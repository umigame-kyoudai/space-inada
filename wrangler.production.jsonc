{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyphoto-miyakojima",
  "account_id": "c1db2261f1b54c87010621b814be41a6",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "keyphotomiyakojima.com", "custom_domain": true, "zone_name": "keyphotomiyakojima.com" },
    { "pattern": "www.keyphotomiyakojima.com", "custom_domain": true, "zone_name": "keyphotomiyakojima.com" },
    { "pattern": "space-inada.com", "custom_domain": true, "zone_name": "space-inada.com" },
    { "pattern": "www.space-inada.com", "custom_domain": true, "zone_name": "space-inada.com" }
  ],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "NEXT_PUBLIC_DEPLOYMENT_STAGE": "production" }
}
